# Secrets — never commit
.env

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# Generated at runtime
.cache/
state/*
!state/.gitkeep
results/*
!results/.gitkeep
# ...but keep the committed readout baselines (the "before" numbers)
!results/baseline_*.json

# OS / editor
.DS_Store
.vscode/
.venv/
.gstack/

# Copy this file to .env and fill in your values.
#   cp .env.example .env

# --- Required: LLM access (OpenAI-compatible endpoint) ---
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL=gpt-4o-mini

# --- Optional: server (defaults shown) ---
# PORT=9001
# HOST=127.0.0.1

# --- Optional: auth / security (defaults are fine for local dev) ---
# SECRET_KEY=change-me-in-production
# AUTH_SECRET_KEY=change-me-in-production
# TOKEN_EXPIRY_MINUTES=15
# SESSION_TIMEOUT_HOURS=24
# RATE_LIMIT_PER_MINUTE=60

# --- Optional: tuning (defaults are fine) ---
# MAX_CONVERSATION_TURNS=20   # transcript messages resent per call. Lower =
#                             # cheaper on long chats (S1 cost). Safe to lower:
#                             # looked-up order facts live in working memory,
#                             # not just the transcript (see tests/test_memory
#                             # ::TestTrimmingPreservesFactsViaWorkingMemory).
#                             # Default 40; try 12-16 and measure cost vs score.
# MAX_PLANNER_STEPS=5
# MAX_PLAN_ROUNDS=3
# MAX_TRACE_EVENTS=500
# MAX_STEPS=6                 # ReAct tool-loop ceiling
# LLM_RETRY_TRIES=6           # 429 / 5xx backoff attempts

# --- Optional: model routing (S6 — disabled by default) ---
# MODEL_CHEAP=                # cheap tier for simple/PUBLIC turns ("" = off)
# MODEL_STRONG=               # strong tier for hard turns ("" = use MODEL)

# --- Optional: graceful degradation (S4) ---
# TURN_BUDGET_SECONDS=0       # degrade a turn that runs longer than this (0 = off)

# --- Optional: monitoring alerts (S2 — 0 disables each) ---
# ALERT_ERROR_RATE_PCT=0
# ALERT_COST_PER_TURN_USD=0
# ALERT_P95_MS=0
